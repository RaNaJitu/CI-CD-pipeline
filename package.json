{
  "name": "cicd-learning",
  "version": "1.0.0",
  "description": "Interactive CI/CD learning app with DEV, Stage, and Prod environments",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "APP_ENV=development NODE_ENV=development node src/server.js",
    "build": "node scripts/build.js",
    "start:dist": "node dist/src/server.js",
    "deploy:dev": "node scripts/deploy-dev.js",
    "healthcheck": "node scripts/health-check.js",
    "test": "node ./node_modules/jest/bin/jest.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "cicd",
    "devops",
    "learning",
    "node"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0"
  }
}
